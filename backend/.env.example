# PostgreSQL de Windows (pgAdmin) visto desde WSL: deja DB_HOST=windows
DB_HOST=windows
DB_PORT=5432
DB_NAME=control_escolar
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_pgadmin
# Solo si la base exige SSL
DB_SSL=false
PORT=3000
JWT_SECRET=cambia_esto_por_una_frase_larga
# Token del bot de Telegram (el mismo de @BotFather que ya usan)
TELEGRAM_BOT_TOKEN=
# Dirección pública del portal: se imprime en las constancias para verificarlas
URL_PUBLICA=http://localhost:5173

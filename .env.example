# Copia este archivo a .env (no se sube a GitHub) y llena los valores.
# Genera claves con: openssl rand -hex 24
DB_PASSWORD=
JWT_SECRET=
# Clave entre n8n y la API: la misma va en la credencial "API Control Escolar (X-Bot-Token)" de n8n
BOT_API_TOKEN=
# Token de @BotFather (el mismo bot de siempre)
TELEGRAM_BOT_TOKEN=
# Usuario del bot sin @, para el enlace "ábrelo aquí" del portal (opcional)
VITE_BOT_TELEGRAM=
# Dirección del portal; se imprime en las constancias para verificarlas
URL_PUBLICA=http://localhost:8080
# Dirección https del túnel (docker compose logs tunel); después: docker compose up -d n8n
WEBHOOK_URL=
OLLAMA_MODELO=qwen2.5:3b
# PUERTO_WEB=8080
# PUERTO_DB=5433
